# Домен для HTTPS (Traefik получит SSL автоматически)
# Пример: autoposter.example.com  или  srv1425385.hstgr.cloud
DOMAIN=srv1425385.hstgr.cloud

# Секрет для Flask сессий — ОБЯЗАТЕЛЬНО замените на свой!
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
WEB_SECRET_KEY=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ

# Всё остальное настраивается в веб-интерфейсе (Settings):
# - TikTok @username
# - Telegram Bot Token
# - Telegram Channel ID
# - Интервал проверки TikTok
# - Включение/отключение платформ
